SERVICE_NAME=customer-service
APP_ENV=docker

HTTP_HOST=0.0.0.0
HTTP_PORT=8442
HTTP_CERT_FILE=
HTTP_KEY_FILE=

GRPC_HOST=0.0.0.0
GRPC_PORT=9092
SUPPLIER_SERVICE_GRPC_ADDR=host.docker.internal:9091

DB_HOST=softplace-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=softplace
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

JWT_SECRET=super-secret-key-change-me
JWT_LIFETIME_HOURS=24

LOG_LEVEL=debug
LOG_FORMAT=text
LOG_OUTPUTS=stdout
LOG_FILE_DIR=logs
LOG_FILE_PREFIX=customer-service
LOG_ADD_SOURCE=true

